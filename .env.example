# Vercel Marketplace Postgres (Neon) 连接串
# 在 Vercel 控制台集成 Neon 后会自动注入；本地开发从 Neon Dashboard 获取
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# better-auth 会话加密密钥（生产环境必须设置随机强密钥，例如 `openssl rand -base64 32`）
BETTER_AUTH_SECRET="please-change-me"

# 站点基础 URL（生产为 Vercel 部署域名；本地开发为 http://localhost:3000）
BETTER_AUTH_URL="http://localhost:3000"
